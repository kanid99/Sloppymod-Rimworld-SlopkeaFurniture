<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <!-- Every Slopkea piece inherits from this: always stuffable, always flat-pack (minifiable). -->
  <ThingDef Name="SlopkeaFurnitureBase" ParentName="FurnitureWithQualityBase" Abstract="True">
    <category>Building</category>
    <designationCategory>Furniture</designationCategory>
    <minifiedDef>MinifiedThing</minifiedDef>
    <thingCategories>
      <li>BuildingsFurniture</li>
    </thingCategories>
    <altitudeLayer>Building</altitudeLayer>
    <drawerType>MapMeshOnly</drawerType>
    <size>(1,1)</size>
    <useHitPoints>true</useHitPoints>
    <socialPropernessMatters>true</socialPropernessMatters>
    <constructionSkillPrerequisite>2</constructionSkillPrerequisite>
    <tradeTags>
      <li>Furniture</li>
    </tradeTags>
  </ThingDef>

  <!-- GLÖMSTRÄK: one cell of a table. Drag out an area and it merges into one table. -->
  <ThingDef ParentName="SlopkeaFurnitureBase">
    <defName>Slopkea_DiningTable</defName>
    <label>GLÖMSTRÄK table segment</label>
    <description>A single flat-pack table panel. Drag out any shape - rectangles, L's, U's, a crude outline of Sweden - and neighbouring panels lock together into one seamless dining table. Pawns can eat at every edge.</description>
    <thingClass>SlopkeaFurniture.Building_SlopkeaTable</thingClass>
    <graphicData>
      <texPath>Slopkea/Table/Table_Top</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <drawSize>(1,1)</drawSize>
    </graphicData>
    <uiIconPath>Slopkea/Table/Table_Icon</uiIconPath>
    <placingDraggableDimensions>2</placingDraggableDimensions>
    <rotatable>false</rotatable>
    <passability>PassThroughOnly</passability>
    <pathCost>42</pathCost>
    <fillPercent>0.4</fillPercent>
    <castEdgeShadows>true</castEdgeShadows>
    <staticSunShadowHeight>0.20</staticSunShadowHeight>
    <surfaceType>Eat</surfaceType>
    <stuffCategories>
      <li>Metallic</li>
      <li>Woody</li>
      <li>Stony</li>
    </stuffCategories>
    <costStuffCount>12</costStuffCount>
    <statBases>
      <MaxHitPoints>50</MaxHitPoints>
      <WorkToBuild>350</WorkToBuild>
      <Mass>4</Mass>
      <Flammability>1.0</Flammability>
      <Beauty>0.5</Beauty>
    </statBases>
    <comps>
      <li>
        <compClass>CompGatherSpot</compClass>
      </li>
    </comps>
  </ThingDef>

  <!-- BÖRKSTÅD: one seat of a modular sectional couch. -->
  <ThingDef ParentName="SlopkeaFurnitureBase">
    <defName>Slopkea_SectionalSeat</defName>
    <label>BÖRKSTÅD sectional seat</label>
    <description>One seat of a modular sectional. Line them up, turn a corner, make a conversation pit. Backrests follow each seat's facing, armrests appear at the open ends and corners wrap themselves. Doubles as a comfy dining chair.</description>
    <thingClass>SlopkeaFurniture.Building_SlopkeaSectional</thingClass>
    <graphicData>
      <texPath>Slopkea/Sectional/Sectional_Seat</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <drawSize>(1,1)</drawSize>
    </graphicData>
    <uiIconPath>Slopkea/Sectional/Sectional_Icon</uiIconPath>
    <placingDraggableDimensions>1</placingDraggableDimensions>
    <rotatable>true</rotatable>
    <defaultPlacingRot>South</defaultPlacingRot>
    <passability>PassThroughOnly</passability>
    <pathCost>30</pathCost>
    <fillPercent>0.4</fillPercent>
    <stuffCategories>
      <li>Fabric</li>
      <li>Leathery</li>
      <li>Woody</li>
      <li>Metallic</li>
      <li>Stony</li>
    </stuffCategories>
    <costStuffCount>45</costStuffCount>
    <statBases>
      <MaxHitPoints>80</MaxHitPoints>
      <WorkToBuild>1000</WorkToBuild>
      <Mass>10</Mass>
      <Flammability>1.0</Flammability>
      <Beauty>2</Beauty>
      <Comfort>0.75</Comfort>
    </statBases>
    <building>
      <isSittable>true</isSittable>
    </building>
  </ThingDef>

</Defs>
