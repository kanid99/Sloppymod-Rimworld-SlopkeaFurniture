<Project Sdk="Microsoft.NET.Sdk">
  <!-- Checks every field in Defs/ against RimWorld's own types, the way the
       game's XML loader does, so "doesn't correspond to any field" errors are
       caught before the game sees them. Usage is in Source/DefCheck/README.md. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="System.Reflection.MetadataLoadContext" Version="8.0.0" />
    <PackageReference Include="Krafs.Rimworld.Ref" Version="1.6.4871" ExcludeAssets="all" GeneratePathProperty="true" />
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies.net472" Version="1.0.3" ExcludeAssets="all" GeneratePathProperty="true" />
  </ItemGroup>
</Project>
